{
  "name": "sync-selfhost",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "concurrently -k \"vite --config client/vite.config.ts --host 0.0.0.0\" \"tsx watch server/src/index.ts\"",
    "typecheck": "tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p client/tsconfig.json",
    "build": "npm run typecheck && vite build --config client/vite.config.ts && tsup server/src/index.ts --format esm --platform node --target node22 --out-dir server/dist --clean --no-splitting --external better-sqlite3",
    "start": "node server/dist/index.js",
    "smoke": "tsx scripts/smoke-test.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.100.10",
    "better-sqlite3": "12.4.1",
    "drizzle-orm": "0.45.2",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.13",
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.5",
    "@types/node": "22.19.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.1",
    "concurrently": "9.2.1",
    "tailwindcss": "4.1.13",
    "tailwindcss-safe-area": "1.3.0",
    "tsup": "8.5.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  }
}
